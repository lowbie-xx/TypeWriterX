{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypeWriterX",
  "version": "0.1.0",
  "identifier": "app.typewriterx.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TypeWriterX",
        "width": 1100,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#24201c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Typewriter word processor",
    "longDescription": "A lightweight word processor that behaves like a real typewriter: overstrikes, ribbon bands, ink that varies with your touch, and free platen movement.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["twx"],
        "name": "TypeWriterX Document",
        "description": "TypeWriterX Document",
        "role": "Editor",
        "mimeType": "application/x-typewriterx"
      }
    ],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
