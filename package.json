{
  "name": "typewriterx",
  "private": true,
  "version": "0.1.0",
  "description": "A lightweight typewriter-emulating word processor.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "RUSTFLAGS=\"--remap-path-prefix=$HOME=/build\" tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
